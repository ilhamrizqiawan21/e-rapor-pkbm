APP_NAME="E-Rapor PKBM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Ganti jika alamat Laragon Anda berbeda.
APP_URL=http://e-rapor-pkbm.test
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
ERAPOR_SEED_DEMO_DATA=true

# Localhost memakai SQLite agar tidak perlu membuat database MySQL.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SECURITY_FORCE_HTTPS=false
SECURITY_HSTS=false

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=public
REPORT_ARCHIVE_DISK=local
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=02:30
BACKUP_TIMEOUT_SECONDS=300
BACKUP_MAX_RESTORE_BYTES=536870912
BACKUP_ENCRYPTION=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Lokasi Chrome Windows yang umum. Jika berbeda, ganti nilainya.
PDF_BROWSER_BINARY="C:/Program Files/Google/Chrome/Application/chrome.exe"
PDF_BROWSER_TIMEOUT=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
