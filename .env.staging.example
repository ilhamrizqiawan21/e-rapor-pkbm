APP_NAME="E-Rapor PKBM"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# Jika dipasang di subfolder, sertakan subpath, misalnya
# APP_URL=https://example.test/e-rapor-pkbm
APP_URL=https://staging.example.test
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
ERAPOR_SEED_DEMO_DATA=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erapor_staging
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SECURITY_FORCE_HTTPS=true
SECURITY_HSTS=true
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=public
REPORT_ARCHIVE_DISK=local
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=02:30
BACKUP_TIMEOUT_SECONDS=300
BACKUP_MAX_RESTORE_BYTES=536870912
BACKUP_ENCRYPTION=true

# Set this to the installed Chrome/Chromium executable when it is not on PATH.
# Examples: google-chrome, google-chrome-stable, chromium, chromium-browser,
# wkhtmltopdf, or an absolute path such as /usr/bin/wkhtmltopdf.
PDF_BROWSER_BINARY=google-chrome
PDF_BROWSER_TIMEOUT=30

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
