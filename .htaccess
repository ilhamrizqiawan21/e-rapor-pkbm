Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve Laravel's public assets while keeping the project root private.
    RewriteRule ^(build(?:/.*)?|storage(?:/.*)?|favicon\.ico|favicon\.svg|robots\.txt)$ public/$1 [L]

    # Send application routes to Laravel's public front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.(env|git|ht)">
    Require all denied
</FilesMatch>
